{
  "name": "Ye Olde Script",
  "scopeName": "source.yeolde",
  "fileTypes": ["yeolde", "ye", "parchment", "scrollx", "illuminated"],
  "patterns": [
    { "include": "#directives" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#jsx" },
    { "include": "#function-definition" },
    { "include": "#type-definition" },
    { "include": "#ts-types" },
    { "include": "#booleans-and-nulls" },
    { "include": "#imports-exports" },
    { "include": "#nextjs" },
    { "include": "#react-hooks" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-function" },
    { "include": "#keywords-control" },
    { "include": "#keywords-error" },
    { "include": "#keywords-return" },
    { "include": "#keywords-operators" },
    { "include": "#builtins" },
    { "include": "#method-aliases" },
    { "include": "#town-crier" },
    { "include": "#numbers" }
  ],
  "repository": {

    "function-definition": {
      "comment": "`Incantation foo(...)` — colour the function name. Works for both sync and async (`Henceforth Incantation foo`) since `Henceforth` is matched separately as a keyword.",
      "match": "\\b(Incantation)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
      "captures": {
        "1": { "name": "keyword.declaration.function.yeolde" },
        "2": { "name": "entity.name.function.yeolde" }
      }
    },

    "type-definition": {
      "comment": "`Covenant Foo {...}`, `Proclamation Bar = ...`, `HierarchyOfRank Baz` — colour the type name.",
      "match": "\\b(Covenant|Proclamation|HierarchyOfRank)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
      "captures": {
        "1": { "name": "keyword.declaration.type.yeolde" },
        "2": { "name": "entity.name.type.yeolde" }
      }
    },

    "directives": {
      "patterns": [
        {
          "name": "meta.preprocessor.directive.yeolde string.quoted.single.yeolde",
          "match": "'this parchment doth run on the (client|server)'"
        }
      ]
    },

    "comments": {
      "patterns": [
        { "name": "comment.line.yeolde", "match": "//.*$" },
        { "name": "comment.block.yeolde", "begin": "/\\*", "end": "\\*/" }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.yeolde",
          "begin": "\"", "end": "\"",
          "patterns": [{ "name": "constant.character.escape.yeolde", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.yeolde",
          "begin": "'", "end": "'",
          "patterns": [{ "name": "constant.character.escape.yeolde", "match": "\\\\." }]
        },
        {
          "name": "string.template.yeolde",
          "begin": "`", "end": "`",
          "patterns": [
            { "name": "constant.character.escape.yeolde", "match": "\\\\." },
            { "name": "meta.template.expression.yeolde", "begin": "\\$\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        }
      ]
    },

    "jsx": {
      "patterns": [
        {
          "comment": "JSX opening tags — capture the name so the theme's entity.name.tag colour applies (the wrapping meta.tag scope alone usually only colours the angle brackets).",
          "name": "meta.tag.jsx.open.yeolde",
          "match": "(<)([A-Za-z][A-Za-z0-9.]*)(?=\\s|>|/)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.yeolde" },
            "2": { "name": "entity.name.tag.yeolde" }
          }
        },
        {
          "comment": "JSX closing tags",
          "name": "meta.tag.jsx.close.yeolde",
          "match": "(</)([A-Za-z][A-Za-z0-9.]*)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.yeolde" },
            "2": { "name": "entity.name.tag.yeolde" },
            "3": { "name": "punctuation.definition.tag.end.yeolde" }
          }
        },
        {
          "comment": "JSX props with values — medieval versions",
          "name": "entity.other.attribute-name.yeolde",
          "match": "\\b(caste|uponBeingStruck|uponMutation|uponSubmission|uponKeystroke|uponKeyRelease|uponGazing|uponLookingAway|uponHovering|uponFleeing|uponLoading|uponScrolling|uponError|uponMousePressed|uponMouseReleased|uponMouseRoaming|uponConjuring|uponDoubleStruck|uponDragging|uponDropping|uponWheeling|uponCopying|uponCutting|uponPasting|uponPlaying|uponPausing|uponEnding|imprisoned|prophecy|destination|provenance|inscription|tether|genus|calling|sigil|sealKey|treasure|compulsory|station|placardFor|command|rite|tongue|tooltip|flourish|wherethrough|relation|speakAs|speakAsBy|invisibleToHerald|describedAsBy|currentlyAt|breadth|stature|spans|fillEntirely|urgent|inkFrame|inkFill|inkOutline|inkOutlineWidth|inkOutlineEnd|inkOutlineJoin|inkFillRule|inkClipRule|namespaceFrom|inkData|least|most|tick|leastLength|mostLength|originalTreasure|originalMark|marked|chosen|many)(?==)"
        },
        {
          "comment": "Boolean JSX props — same words, no value attached",
          "name": "entity.other.attribute-name.yeolde",
          "match": "\\b(compulsory|urgent|fillEntirely|invisibleToHerald|imprisoned|marked|chosen|many|originalMark)(?=[\\s/>])"
        }
      ]
    },

    "ts-types": {
      "patterns": [
        {
          "comment": "TypeScript primitive types (medieval)",
          "name": "support.type.primitive.yeolde",
          "match": "\\b(Parchment|Tally|TrueOrNay|Naught|WhateverThouWilt|Mysterious|NeverEth|Nevereth)\\b"
        },
        {
          "comment": "TypeScript complex types (medieval)",
          "name": "support.type.yeolde",
          "match": "\\b(Multitude|Oath|Ledger|PartialScroll|RequiredByLaw|ReadOnlyScroll|PickThyFields|OmitHeresy|ExcludeThePeasants)\\b"
        },
        {
          "comment": "TypeScript declarations",
          "name": "keyword.declaration.type.yeolde",
          "match": "\\b(Covenant|Proclamation|HierarchyOfRank)\\b"
        },
        {
          "comment": "TypeScript modifiers",
          "name": "keyword.other.modifier.yeolde",
          "match": "\\b(Immutable|Concealed|Shielded|Exposed|Stationary|RoyallyAbstract|bequeatheth|abideth by|disguiseth as|the nature of|the keys of)\\b"
        }
      ]
    },

    "booleans-and-nulls": {
      "patterns": [
        { "name": "constant.language.boolean.true.yeolde",  "match": "\\bVerily\\b" },
        { "name": "constant.language.boolean.false.yeolde", "match": "\\bNay\\b" },
        { "name": "constant.language.null.yeolde",          "match": "\\bNothingness\\b" },
        { "name": "constant.language.undefined.yeolde",     "match": "\\bVoid\\b" }
      ]
    },

    "imports-exports": {
      "patterns": [
        {
          "name": "keyword.control.import-export.yeolde",
          "match": "\\b(PresentToTheKingdom|ShareWithTheRealm|Summon|hailing from)\\b"
        }
      ]
    },

    "nextjs": {
      "patterns": [
        {
          "comment": "Next.js hooks",
          "name": "support.function.nextjs.yeolde",
          "match": "\\b(consultTheRoyalMap|whereAmI|readTheScroll|watchTheRoad)\\b"
        },
        {
          "comment": "Next.js data fetching",
          "name": "support.function.nextjs.datafetch.yeolde",
          "match": "\\b(fetchFromTheKingdomServer|inscribeIntoStone|cartographTheKingdom|fetchFromTheRoyalVault)\\b"
        },
        {
          "comment": "Next.js server functions",
          "name": "support.function.nextjs.server.yeolde",
          "match": "\\b(redirectToExile|notFoundInTheKingdom|royalMetadata|summonFromTheVault|readTheRoyalHeaders)\\b"
        }
      ]
    },

    "react-hooks": {
      "patterns": [
        {
          "name": "support.function.react-hook.yeolde",
          "match": "\\b(useCrystalBall|whenTheMoonRiseth|useParchmentScroll|consultTheOracle|remembereth|recallIncantation|useCouncilOfElders|forgeRef|createScrollContext|useLayoutSorcery|useImperativeScroll|useDeferredToil|useIdScroll)\\b"
        },
        {
          "name": "support.class.react.yeolde",
          "match": "\\b(fragmentOfReality|suspendThyBelief|createPortalgate)\\b"
        }
      ]
    },

    "keywords-declaration": {
      "name": "keyword.declaration.yeolde",
      "match": "\\b(Beholdeth|Decree|Proclameth)\\b"
    },

    "keywords-function": {
      "patterns": [
        {
          "name": "keyword.declaration.function.yeolde",
          "match": "\\b(Incantation|Henceforth)\\b"
        },
        {
          "name": "keyword.control.async.yeolde",
          "match": "\\bAwaiteth\\b"
        }
      ]
    },

    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.conditional.yeolde",
          "match": "\\b(Shouldst|Elsewise|Perchance)\\b"
        },
        {
          "name": "keyword.control.conditional.elseif.yeolde",
          "match": "\\bAlas,\\s+Shouldst\\b"
        },
        {
          "name": "keyword.control.loop.yeolde",
          "match": "\\b(Whilst|Traverse|ForEachPeasant)\\b"
        },
        {
          "name": "keyword.control.switch.yeolde",
          "match": "\\b(SwitchThyFate|CaseOf|BreakFree|ContinueSuffering)\\b"
        }
      ]
    },

    "keywords-error": {
      "name": "keyword.control.trycatch.yeolde",
      "match": "\\b(TemptFate|Repent|Finalleth)\\b"
    },

    "keywords-return": {
      "patterns": [
        { "name": "keyword.control.return.yeolde",   "match": "\\bBestow\\b" },
        { "name": "keyword.control.throw.yeolde",    "match": "\\bYeet\\b" },
        { "name": "keyword.other.debugger.yeolde",   "match": "\\bForsooth\\b" }
      ]
    },

    "keywords-operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.yeolde",
          "match": "\\b(doth equal|doth not equal|be as one with|surpass|surpasseth|falleth below|no less than|no more than)\\b"
        },
        {
          "name": "keyword.operator.logical.yeolde",
          "match": "\\b(and furthermore|or perchance)\\b"
        },
        {
          "name": "keyword.operator.assignment.yeolde",
          "match": "\\bart\\b"
        },
        {
          "name": "keyword.operator.arithmetic.yeolde",
          "match": "\\b(plus|minus|times|over|modulo)\\b"
        },
        {
          "name": "keyword.operator.arrow.yeolde",
          "match": "\\bbecometh\\b"
        },
        {
          "name": "keyword.operator.ternary.yeolde",
          "match": "\\bdothQuestionThyExistence\\b"
        },
        {
          "name": "punctuation.terminator.statement.yeolde",
          "match": "\\bendeth\\b"
        },
        {
          "name": "keyword.operator.delete.yeolde",
          "match": "\\bDeleteFromExistence\\b"
        }
      ]
    },

    "builtins": {
      "patterns": [
        {
          "comment": "Built-in constructors and globals (medieval aliases).",
          "name": "support.class.builtin.yeolde",
          "match": "\\b(Gathering|WeakGathering|Codex|WeakCodex|Era|Glyph|Arithmetic|tallyOf|truthOf|wordOf)\\b"
        },
        {
          "comment": "HTML/SVG element types (medieval aliases for HTMLDivElement etc.).",
          "name": "support.type.dom.yeolde",
          "match": "\\b(BaseElement|ScrollElement|SliverElement|VerseElement|PilgrimageElement|LeverElement|QuillElement|WideQuillElement|MenuOfChoicesElement|PetitionElement|PaintingElement|HeadingElement|InkElement|InkCanvasElement|InkStrokeElement)\\b"
        },
        {
          "comment": "React utility types under the React namespace.",
          "name": "support.type.react.yeolde",
          "match": "\\bReact\\.(Heir|Manuscript|Tether|TetherObject|MutableTether|UponBeingStruckEvent|UponMutationEvent|UponSubmissionEvent|UponKeystrokeEvent)\\b"
        }
      ]
    },

    "method-aliases": {
      "patterns": [
        {
          "comment": "Specific named method aliases for built-ins (Math, Error, Date, Array.from, DOM events).",
          "name": "support.function.method.yeolde",
          "match": "\\.(descendeth|ascendeth|roundeth|abseth|greatest|lowest|fortune|poweth|sqrteth|signOf|truncate|gather|thwart|silence|silenceForever|lament|toStringeth|toScroll)\\b"
        },
        {
          "comment": "Catch-all for the -eth suffix pattern that covers most array/string/promise method aliases (.mapeth, .filtereth, .lowereth, .theneth, etc.). Tightly bounded so it doesn't catch English words ending in eth in comments.",
          "name": "support.function.method.yeolde",
          "match": "\\.[a-zA-Z]+eth\\b"
        }
      ]
    },

    "town-crier": {
      "patterns": [
        {
          "name": "support.function.towncrier.yeolde",
          "match": "\\bTownCrier\\.(bellow|weep|mumble|shriek|whisper|proclaim|tableOfContents|countThePeasants|time|timeEndeth)\\b"
        },
        {
          "name": "support.class.towncrier.yeolde",
          "match": "\\bTownCrier\\b"
        }
      ]
    },

    "numbers": {
      "name": "constant.numeric.yeolde",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    }
  }
}
