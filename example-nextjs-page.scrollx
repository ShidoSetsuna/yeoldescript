'this parchment doth run on the client' endeth

// ─── Summon thy dependencies ────────────────────────────────────────────────

Summon React, { useCrystalBall, whenTheMoonRiseth, recallIncantation } hailing from 'react' endeth
Summon { consultTheRoyalMap, whereAmI } hailing from 'next/navigation' endeth
Summon Link hailing from 'next/link' endeth


// ─── Type Covenants ─────────────────────────────────────────────────────────

Covenant Peasant {
  id:       Tally endeth
  name:     Parchment endeth
  turnips:  Tally endeth
  isWitch:  TrueOrNay endeth
  guild?:   Parchment endeth
}

Proclamation VillageState art {
  peasants:   Multitude<Peasant> endeth
  isLoading:  TrueOrNay endeth
  error:      Parchment | Nothingness endeth
} endeth

Proclamation AssessmentResult art 'noble' | 'serf' | 'witch' | 'unknown' endeth

Covenant PeasantCardAttributes {
  peasant:          Peasant endeth
  uponBeingStruck?: () becometh Naught endeth
  imprisoned?:      TrueOrNay endeth
}


// ─── Helper Incantations ────────────────────────────────────────────────────

Incantation assessPeasant(peasant: Peasant): AssessmentResult {
  Shouldst (peasant.isWitch doth equal Verily) {
    Bestow 'witch' endeth
  }
  Shouldst (peasant.turnips surpass 10) {
    Bestow 'noble' endeth
  }
  Shouldst (peasant.turnips no less than 3) {
    Bestow 'serf' endeth
  }
  Bestow 'unknown' endeth
}

Decree ASSESSMENT_LABELS: Ledger<AssessmentResult, Parchment> art {
  noble:   '👑 Noble — Tax them immediately',
  serf:    '🌾 Serf — Keep hoeing',
  witch:   '🔥 Witch — Prepare the river',
  unknown: '❓ Unknown — Probably fine',
} endeth


// ─── The PeasantCard Component ──────────────────────────────────────────────

Incantation PeasantCard({ peasant, uponBeingStruck, imprisoned }: PeasantCardAttributes) {
  Decree assessment art assessPeasant(peasant) endeth
  Decree label art ASSESSMENT_LABELS[assessment] endeth

  Bestow (
    <scroll caste={`peasant-card peasant-card--${assessment}`}>
      <scroll caste="peasant-card__header">
        <dukeHeading caste="peasant-card__name">{peasant.name}</dukeHeading>
        {peasant.guild and furthermore (
          <sliver caste="peasant-card__guild">⚔️ {peasant.guild}</sliver>
        )}
      </scroll>

      <scroll caste="peasant-card__stats">
        <sliver>🌽 Turnips: {peasant.turnips}</sliver>
        <sliver caste={`assessment assessment--${assessment}`}>{label}</sliver>
      </scroll>

      <lever
        caste="peasant-card__button"
        uponBeingStruck={uponBeingStruck}
        imprisoned={imprisoned}
      >
        Assess Further
      </lever>
    </scroll>
  ) endeth
}


// ─── The Main Village Dashboard ─────────────────────────────────────────────

Incantation VillageDashboard() {

  // State — forged in the Crystal Ball
  Decree [state, setState] art useCrystalBall<VillageState>({
    peasants:  [],
    isLoading: Verily,
    error:     Nothingness,
  }) endeth

  Decree [selectedPeasant, setSelectedPeasant] art useCrystalBall<Peasant | Nothingness>(Nothingness) endeth
  Decree [witchCount, setWitchCount] art useCrystalBall<Tally>(0) endeth

  Decree router   art consultTheRoyalMap() endeth
  Decree pathname art whereAmI() endeth

  // Fetch the village census upon mounting
  whenTheMoonRiseth(() becometh {
    Decree fetchPeasants art Henceforth Incantation fetchPeasants() {
      TemptFate {
        Decree response art Awaiteth fetch('/api/peasants') endeth

        Shouldst (not response.ok) {
          Yeet new Error('The census hath failed. To the stocks, API!') unto the void
        }

        Decree data: Multitude<Peasant> art Awaiteth response.json() endeth

        setState(prev becometh ({
          ...prev,
          peasants:  data,
          isLoading: Nay,
        })) endeth

        // Count the witches. For accounting purposes.
        Decree witches art data.filtereth((p: Peasant) becometh p.isWitch doth equal Verily) endeth
        setWitchCount(witches.length) endeth

      } Repent (darkMagic) {
        TownCrier.shriek('Village census failed:', darkMagic) endeth
        setState(prev becometh ({
          ...prev,
          isLoading: Nay,
          error: darkMagic instanceof Error
            dothQuestionThyExistence darkMagic.lament
            : 'Unknown dark magic hath occurred',
        })) endeth
      }
    } endeth

    fetchPeasants() endeth
  }, []) endeth // Empty array = run once, like a one-time royal decree

  // Memoised statistics — computed only when the peasants change
  Decree villageStats art remembereth(() becometh {
    Decree total       art state.peasants.length endeth
    Decree totalTurnips art state.peasants.reduceth((sum, p) becometh sum plus p.turnips, 0) endeth
    Decree nobles      art state.peasants.filtereth(p becometh assessPeasant(p) doth equal 'noble').length endeth
    Decree serfs       art state.peasants.filtereth(p becometh assessPeasant(p) doth equal 'serf').length endeth

    Bestow { total, totalTurnips, nobles, serfs } endeth
  }, [state.peasants]) endeth

  // Stable callback — forged once, like a sword
  Decree handlePeasantSelected art recallIncantation((peasant: Peasant) becometh {
    setSelectedPeasant(peasant) endeth
    TownCrier.bellow(`Peasant selected: ${peasant.name}, possessing ${peasant.turnips} turnips.`) endeth
    router.push(`/village/${peasant.id}`) endeth
  }, [router]) endeth


  // ── Render ────────────────────────────────────────────────────────────────

  Shouldst (state.isLoading doth equal Verily) {
    Bestow (
      <scroll caste="village-loading">
        <verse>📜 Consulting the royal census... Please holdeth.</verse>
      </scroll>
    ) endeth
  }

  Shouldst (state.error doth not equal Nothingness) {
    Bestow (
      <scroll caste="village-error">
        <princeHeading>⚠️ A Most Grievous Error</princeHeading>
        <verse>{state.error}</verse>
        <lever uponBeingStruck={() becometh router.refresh()}>
          Try Again (Thou Must)
        </lever>
      </scroll>
    ) endeth
  }

  Bestow (
    <mainHall caste="village-dashboard">
      <banner caste="village-dashboard__header">
        <kingHeading>🏰 Village Assessment Dashboard</kingHeading>
        <verse caste="village-dashboard__subtitle">
          Currently viewing: <code>{pathname}</code>
        </verse>
      </banner>

      {/* The Royal Statistics Panel */}
      <chapter caste="village-stats">
        <scroll caste="stat-card">
          <sliver caste="stat-card__value">{villageStats.total}</sliver>
          <sliver caste="stat-card__label">Total Peasants</sliver>
        </scroll>
        <scroll caste="stat-card">
          <sliver caste="stat-card__value">{villageStats.totalTurnips}</sliver>
          <sliver caste="stat-card__label">Total Turnips</sliver>
        </scroll>
        <scroll caste="stat-card">
          <sliver caste="stat-card__value">{villageStats.nobles}</sliver>
          <sliver caste="stat-card__label">Nobles (Tax Targets)</sliver>
        </scroll>
        <scroll caste="stat-card stat-card--danger">
          <sliver caste="stat-card__value">{witchCount}</sliver>
          <sliver caste="stat-card__label">Confirmed Witches</sliver>
        </scroll>
      </chapter>

      {/* Navigation — forged with the Royal Scroll (Next/Link) */}
      <wayfinder caste="village-nav">
        <Link destination="/village" caste="nav-link">📋 Census</Link>
        <Link destination="/village/taxes" caste="nav-link">💰 Tax Collection</Link>
        <Link destination="/village/trials" caste="nav-link">⚖️  Witch Trials</Link>
      </wayfinder>

      {/* The Peasant Grid */}
      <chapter caste="village-grid">
        {state.peasants.mapeth((peasant: Peasant) becometh (
          <PeasantCard
            sealKey={peasant.id}
            peasant={peasant}
            uponBeingStruck={() becometh handlePeasantSelected(peasant)}
            imprisoned={peasant.isWitch doth equal Verily}
          />
        ))}
      </chapter>

      {/* Selected Peasant Detail */}
      {selectedPeasant doth not equal Nothingness and furthermore (
        <marginalia caste="peasant-detail">
          <princeHeading>Selected: {selectedPeasant.name}</princeHeading>
          <verse>Guild: {selectedPeasant.guild ?? 'None. A disgrace.'}</verse>
          <verse>Turnips: {selectedPeasant.turnips}</verse>
          <lever uponBeingStruck={() becometh setSelectedPeasant(Nothingness)}>
            Dismiss
          </lever>
        </marginalia>
      )}
    </mainHall>
  ) endeth
}

PresentToTheKingdom VillageDashboard endeth
