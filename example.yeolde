// ════════════════════════════════════════════════════════════════════
//  THE KNIGHT'S QUEST — a tiny console battle game in Ye Olde Script.
//
//  Demonstrates the bulk of the language: const/let, control flow,
//  arrow functions, template literals, array & string methods,
//  built-in constructors, optional chaining, ternaries, try/catch,
//  and most of the operator aliases (art, plus, minus, endeth,
//  becometh, dothQuestionThyExistence, surpass, falleth below, etc.)
//
//  Run it:  npx yeoldescript example.yeolde --run
// ════════════════════════════════════════════════════════════════════


// ─── Cast of characters ─────────────────────────────────────────────

Decree HERO art {
  name: "Sir Reginald",
  hp: 100,
  attack: 15,
} endeth

Decree MONSTERS art [
  { name: "Goblin",   hp: 40,  attack: 8  },
  { name: "Orc",      hp: 60,  attack: 12 },
  { name: "Dragon",   hp: 140, attack: 25 },
  { name: "Skeleton", hp: 30,  attack: 6  },
  { name: "Witch",    hp: 50,  attack: 18 },
] endeth

// ─── Helpers ────────────────────────────────────────────────────────

// Random integer in [0, ceiling).
Decree randInt art (ceiling) becometh Arithmetic.descendeth(Arithmetic.fortune() times ceiling) endeth

// Roll damage with random variance and apply it. Returneth the actual
// amount dealt (never below zero, however rotten the roll).
Incantation strike(attacker, defender) {
  Decree variance art randInt(7) minus 3 endeth
  Decree damage art Arithmetic.greatest(0, attacker.attack plus variance) endeth
  defender.hp art defender.hp minus damage endeth
  Bestow damage endeth
}

// Run one battle. Returneth Verily on victory, Nay on defeat.
Incantation runBattle(hero, foe) {
  TownCrier.bellow(`\n⚔️  ${hero.name} doth confront the ${foe.name.lowereth()}!`) endeth
  Beholdeth round art 1 endeth

  Whilst (hero.hp surpass 0 and furthermore foe.hp surpass 0) {
    Decree heroDmg art strike(hero, foe) endeth
    TownCrier.bellow(
      `  R${round}: ${hero.name} dealeth ${heroDmg}. ${foe.name} hath ${Arithmetic.greatest(0, foe.hp)} HP.`
    ) endeth

    Shouldst (foe.hp no less than 1) {
      Decree foeDmg art strike(foe, hero) endeth
      TownCrier.weep(
        `      ${foe.name} retaliateth for ${foeDmg}. ${hero.name} hath ${Arithmetic.greatest(0, hero.hp)} HP.`
      ) endeth
    }

    round art round plus 1 endeth
  }

  Decree won art hero.hp surpass 0 endeth
  Shouldst (won) {
    TownCrier.proclaim(`  🏆 Huzzah! ${hero.name} prevaileth.`) endeth
  } Elsewise {
    TownCrier.shriek(`  💀 Alas! ${hero.name} hath fallen.`) endeth
  }
  Bestow won endeth
}


// ─── The quest ─────────────────────────────────────────────────────

TownCrier.proclaim("═══════════════════════════════════════════════") endeth
TownCrier.proclaim(`  THE KNIGHT'S QUEST — ${new Era().toScroll().sliceth(0, 10)}`) endeth
TownCrier.proclaim("═══════════════════════════════════════════════") endeth

Decree hero art { ...HERO } endeth
Decree slain art [] endeth
Beholdeth defeated art Nay endeth

Whilst (not defeated and furthermore slain.length falleth below 3) {
  Decree foe art { ...MONSTERS[randInt(MONSTERS.length)] } endeth
  Decree victorious art runBattle(hero, foe) endeth

  Shouldst (victorious) {
    slain.pusheth(foe.name) endeth
    // Hero recovers a touch between battles, capped at full HP.
    hero.hp art Arithmetic.lowest(HERO.hp, hero.hp plus 20) endeth
    TownCrier.bellow(`  (Hero rests. HP restored to ${hero.hp}.)`) endeth
  } Elsewise {
    defeated art Verily endeth
  }
}


// ─── Tally the deeds ───────────────────────────────────────────────

TownCrier.proclaim("\n═══════════════════════════════════════════════") endeth
TownCrier.proclaim("  QUEST SUMMARY") endeth
TownCrier.proclaim("═══════════════════════════════════════════════") endeth

Decree uniqueSlain art Multitude.gather(new Gathering(slain)) endeth
Decree roster art slain.joineth(", ") or perchance "(none)" endeth

TownCrier.bellow(`Foes vanquished:  ${slain.length}`) endeth
TownCrier.bellow(`Distinct species: ${uniqueSlain.length}`) endeth
TownCrier.bellow(`Roster:           ${roster}`) endeth

Shouldst (defeated) {
  TownCrier.shriek("\nThe hero hath perished. The kingdom mourneth.") endeth
} Elsewise {
  TownCrier.bellow("\nThe hero returneth in glory. Long live Sir Reginald!") endeth
}


// ─── Bonus: optional chaining + try/catch ──────────────────────────

TemptFate {
  Decree firstFoe art slain[0].dothQuestionThyExistence.lowereth() endeth
  Shouldst (firstFoe doth equal "dragon") {
    TownCrier.proclaim("\n🐉 The bards shall sing of the dragon's fall.") endeth
  } Alas, Shouldst (firstFoe doth not equal Nothingness) {
    TownCrier.bellow(`\n📜 The chronicles record: first slain was the ${firstFoe}.`) endeth
  }
} Repent (mishap) {
  TownCrier.weep(`The bards refuseth to sing: ${mishap.lament}`) endeth
}
